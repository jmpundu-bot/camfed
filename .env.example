PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!
SESSION_SECRET=change-this-to-a-long-random-secret
# Required: Neon Postgres connection string for the app's event and attendee records
DATABASE_URL=

# Neon Object Storage (create a private bucket and a storage:read + storage:write credential)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=
AWS_REGION=us-east-2

# Set to the public HTTPS site URL in production, e.g. https://attendance.example.org
PUBLIC_BASE_URL=http://localhost:3000
